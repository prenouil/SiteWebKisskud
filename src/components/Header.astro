---
import { site, navigation } from '../config/site';
import { url, stripBase } from '../utils/url';

const current = stripBase(Astro.url.pathname);
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-white/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between">
    <a href={url('/')} class="text-xl font-bold text-primary">
      {site.name}
    </a>

    <button
      id="menu-toggle"
      class="md:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <nav
      id="main-nav"
      class="absolute inset-x-0 top-16 hidden border-b border-black/5 bg-white md:static md:block md:border-0 md:bg-transparent"
    >
      <ul class="flex flex-col gap-1 p-4 md:flex-row md:gap-6 md:p-0">
        {navigation.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'block py-2 transition-colors hover:text-accent',
                current === item.href && 'font-semibold text-primary',
              ]}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
