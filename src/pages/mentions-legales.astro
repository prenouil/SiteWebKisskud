---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
---

<BaseLayout title="Mentions légales">
  <Section title="Mentions légales">
    <div class="space-y-4 text-ink/80">
      <p>
        <strong>Éditeur du site :</strong> à compléter (raison sociale, forme juridique, SIRET, adresse).
      </p>
      <p>
        <strong>Directeur de la publication :</strong> à compléter.
      </p>
      <p>
        <strong>Hébergeur :</strong> à compléter (nom, adresse, téléphone).
      </p>
    </div>
  </Section>
</BaseLayout>
